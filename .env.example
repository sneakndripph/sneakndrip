# ============================================================
# Sneak N' Drip — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ──────────────────────────────────────────
# Supabase (required for auth, DB, storage)
# Get these from: supabase.com → Project → Settings → API
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used for admin operations ONLY (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sneakndrip.ph
# In development: http://localhost:3000

# Signs one-click unsubscribe links (required — the build fails without it).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never rotate: signed links don't expire, so a new secret breaks every link already sent.
UNSUBSCRIBE_SECRET=your-64-char-hex-secret-here

# ──────────────────────────────────────────
# Facebook Messenger Chat Plugin
# Get from: Facebook Page → Settings → Messaging → Customer Chat Plugin
# ──────────────────────────────────────────
NEXT_PUBLIC_FB_PAGE_ID=123456789012345

# ──────────────────────────────────────────
# Optional: Analytics
# ──────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
