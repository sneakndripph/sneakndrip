# --- REQUIRED ---
# Missing any of these throws at startup (see src/lib/env.ts).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # server-only, never expose to client

# --- OPTIONAL ---
# Missing any of these logs a warning at startup; the app still boots.

RESEND_API_KEY=          # Resend API key. Unset disables all transactional/notification emails.
RESEND_FROM_EMAIL=       # From-address for outbound emails. Unset falls back to a default sender.
ADMIN_EMAIL=             # Address that receives admin notification emails. Unset falls back to a default.
CRON_SECRET=             # Bearer secret Vercel Cron must send. Unset makes cron endpoints fail closed (500).
